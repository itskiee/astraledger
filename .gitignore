# AstraLedger data folders
#
# Commit:
# - data/synthetic/     Curated demo fixtures
# - data/ground-truth/  Evaluation labels
# - data/generators/    Scripts that generate synthetic data
#
# Ignore:
# - data/raw/           Runtime/user uploads
# - data/generated/     Generated runtime datasets
data/raw/*
data/generated/*

!data/raw/.gitkeep
!data/generated/.gitkeep


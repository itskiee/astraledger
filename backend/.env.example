APP_ENV=development

# Note: postgresql+psycopg means psycopg version 3.
# Install psycopg[binary], NOT psycopg2.
DATABASE_URL=postgresql+psycopg://astraledger:change_me@localhost:5432/astraledger

CORS_ORIGINS=http://localhost:3000

# Authentication (Decision 013) — used from Step 5 onward.
# Generate a real secret with:  openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local AI — optional. The app must work with Ollama switched off.
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Razorpay Sandbox — optional, test mode only. Never production keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=